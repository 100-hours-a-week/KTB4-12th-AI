# Explicit build inputs: no local catalog, images, QA logs, credentials or venv.
**
!Dockerfile
!pyproject.toml
!uv.lock
!*.py
!search/
!search/**
!embedding/
!embedding/*.mjs
!embedding/package*.json
!embedding/model.lock.json
!static/
!static/*.html
!static/*.css
!static/*.js
!tools/
!tools/*.py
!tests/
!tests/**
!examples/
!examples/**
.venv/
**/node_modules/
embedding/models/
data/
runtime/
static/images/
static/assets/
.git/
.env
.env.*
**/__pycache__/
**/*.pyc
**/.DS_Store
