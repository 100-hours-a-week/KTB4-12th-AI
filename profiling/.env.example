# profiling 서비스 설정 — 복사해서 .env 로. (.env는 커밋하지 않는다)
PROFILING_BACKEND_BASE_URL=http://localhost:8081
PROFILING_SERVICE_TOKEN=dev-token
# 로컬 DB (docker compose up -d 로 띄운 pgvector/pg16)
PROFILING_DATABASE_URL=postgresql+psycopg://ai_user:ai_password@localhost:5432/ai_chat
# 카탈로그 — db 면 ai_catalog(0003)의 활성 버전을 읽는다(배포는 이쪽, 컨테이너에 파일이 없다). file 이면 아래 JSON
PROFILING_CATALOG_SOURCE=file
# CATALOG_SOURCE=file 일 때만 쓴다. 기본은 레포 안 예시(111건, 56카테고리, 7.9 형식)
PROFILING_CATALOG_FILE=tests/fixtures/catalog_sample.json
# PROFILING_CATALOG_FILE=../../../KTB4_12team/data/gift-catalog-20260915-v1/catalog_enriched.json
PROFILING_POOL_SIZE=30
PROFILING_CALLBACK_TIMEOUT_S=5
PROFILING_LOG_LEVEL=INFO
