# Supply values through the deployment secret store or an external env file.
# Empty secret values are placeholders, never working credentials.
AI_SERVICE_TOKEN=
SESSION_SECRET=
DEMO_ACCESS_TOKEN=
QA_ADMIN_PASSWORD=

# Free local integration path; needs a dedicated disposable chat PostgreSQL DB.
CHAT_RUNTIME_MODE=mock
STORE_MODE=postgres
DATABASE_URL=
COOKIE_SECURE=true
INTERNAL_URL=http://127.0.0.1:7860

# Live mode additionally needs the existing search and model access.
OPENROUTER_API_KEY=
SEARCH_URL=
SEARCH_TOKEN=
# CHAT_MODEL is optional; leaving it unset preserves the source default.

# Only for the alternative http/bridge storage topology.
STORE_URL=
STORE_TOKEN=
CHAT_BRIDGE_URL=

# Protective limits per Runtime/process; measured capacity is not claimed.
CHAT_MAX_PENDING_ADMISSIONS=8
CHAT_MAX_SSE_CONNECTIONS=32
CHAT_MAX_SSE_PER_TURN=4
CHAT_RESOURCE_RETRY_AFTER_SECONDS=2
CHAT_MAX_ACTIVE=4
CHAT_DAILY_LIMIT=200
