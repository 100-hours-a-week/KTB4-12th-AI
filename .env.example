# Service Settings
APP_NAME=seonjalal-ai
APP_ENV=development
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql://ai_user:ai_password@localhost:5432/ai_chat

# Auth & Internal Service Token
INTERNAL_SERVICE_TOKEN=local-dev-service-token

# Main Backend URL (for product catalog export & profile callback)
MAIN_BACKEND_URL=http://localhost:8080

# External LLM / Embedding (if needed)
GEMINI_API_KEY=
OPENAI_API_KEY=
